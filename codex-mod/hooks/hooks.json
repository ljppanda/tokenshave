{
  "description": "tokenshave hooks module — tokenshave — generated by `npx tokenshave install` (Codex CLI hook)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/shave.js\"",
            "timeout": 15,
            "statusMessage": "Shaving shell output with tokenshave"
          }
        ]
      }
    ]
  }
}
