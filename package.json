{
  "name": "tokenshave",
  "version": "0.5.0",
  "description": "Make your AI coding agent faster and cheaper: trim noisy tool output (npm logs, test suites, diffs) before it enters the context. Pure local, zero network, one command.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "tokenshave": "./dist/src/cli.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/engine.test.js dist/test/install.test.js",
    "gen:claude-mod": "node scripts/gen-claude-mod.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "opencode",
    "codex",
    "tokens",
    "context-window",
    "developer-tools"
  ],
  "license": "MIT"
}
